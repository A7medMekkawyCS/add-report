# Environment variables for local development.
# Copy to .env and fill in real values. Never commit .env.

PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/add_info_report
API_SECRET=change-me
CREDENTIALS_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Optional CLI fallback only. API mode reads Odoo credentials from MongoDB.
# ODOO_URL=https://e.aait.sa
# ODOO_LOGIN=
# ODOO_PASSWORD=
# ODOO_EMPLOYEE_NAME=

# Frontend (Vite dev). Leave empty in production so the UI uses the same origin.
VITE_API_URL=
